@model AppPetshop.Models.Agendamento

@{
    ViewData["Title"] = "Edit";
    Layout = "_Layout-outrositens";
}

<h1>Edit</h1>

<h4>Agendamento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Codigo" />
            <div class="form-group">
                <label asp-for="Datahora" class="control-label"></label>
                <input asp-for="Datahora" class="form-control" />
                <span asp-validation-for="Datahora" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IdTutor" class="control-label"></label>
                <select asp-for="IdTutor" class="form-control" asp-items="ViewBag.IdTutor"></select>
                <span asp-validation-for="IdTutor" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IdServico" class="control-label"></label>
                <select asp-for="IdServico" class="form-control" asp-items="ViewBag.IdServico"></select>
                <span asp-validation-for="IdServico" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
