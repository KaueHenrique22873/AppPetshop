@model IEnumerable<AppPetshop.Models.Agendamento>

@{
    ViewData["Title"] = "Index";
    Layout = "_Layout-outrositens";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Datahora)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdServicoNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdTutorNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Datahora)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdServicoNavigation.Codigo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdTutorNavigation.Codigo)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Codigo">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Codigo">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Codigo">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
